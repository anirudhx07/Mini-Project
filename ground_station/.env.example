# COCKPIT Ground Control Station - Environment Configuration Template
# Copy this file to .env and customize for your local setup.
# NEVER commit .env or Wi-Fi credentials to version control.

# Web Server
COCKPIT_HOST=127.0.0.1
COCKPIT_PORT=5000
COCKPIT_DEBUG=false
COCKPIT_SECRET_KEY=replace-with-local-random-key

# Telemetry Communication Mode (USB_SERIAL | UDP_WIFI)
COCKPIT_COMM_MODE=USB_SERIAL

# ESP32 USB Serial Receiver (leave port empty for manual selection / auto-detect CP210x)
COCKPIT_SERIAL_PORT=
COCKPIT_SERIAL_BAUDRATE=115200

# ESP32 UDP Telemetry Receiver (when COCKPIT_COMM_MODE=UDP_WIFI)
COCKPIT_UDP_HOST=0.0.0.0
COCKPIT_UDP_PORT=4210
COCKPIT_ESP32_TIMEOUT=3.0
COCKPIT_TELEMETRY_HISTORY=300

# Camera Source (webcam | esp32cam)
COCKPIT_CAMERA_SOURCE=webcam
COCKPIT_CAMERA_INDEX=0
COCKPIT_CAMERA_WIDTH=640
COCKPIT_CAMERA_HEIGHT=480
COCKPIT_CAMERA_FPS=30
COCKPIT_ESP32_CAM_URL=

# AI / Computer Vision
COCKPIT_YOLO_MODEL=models/yolov8n.pt
COCKPIT_YOLO_CONF=0.40
COCKPIT_AI_DEVICE=auto
COCKPIT_FRAME_SKIP=1
COCKPIT_CAMO_MODEL=

# Storage
COCKPIT_LOG_RETENTION_DAYS=30
