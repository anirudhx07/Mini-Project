/**
 * @file config.h.example
 * @brief SkyForge Remote Controller Configuration Template
 */

#ifndef SKYFORGE_REMOTE_CONFIG_H
#define SKYFORGE_REMOTE_CONFIG_H

// Joystick Analog Input Pins (ADC1 channels recommended)
#define PIN_JOY1_THROTTLE   34  // Left Joystick Y-Axis
#define PIN_JOY1_YAW        35  // Left Joystick X-Axis
#define PIN_JOY2_PITCH      36  // Right Joystick Y-Axis (VP)
#define PIN_JOY2_ROLL       39  // Right Joystick X-Axis (VN)

// Control Buttons
#define PIN_ARM_SWITCH      18  // Toggle switch or momentary button
#define PIN_MODE_BUTTON     19  // Flight mode toggle

// Peer ESP-NOW MAC Address (Drone ESP32 MAC)
static const uint8_t DRONE_PEER_MAC[] = { 0x24, 0x0A, 0xC4, 0x00, 0x00, 0x01 };

#endif // SKYFORGE_REMOTE_CONFIG_H
