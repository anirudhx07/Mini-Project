/**
 * @file secrets.h.example
 * @brief Wi-Fi credentials template for AI Thinker ESP32-CAM OV2640.
 *
 * Copy this file to "secrets.h" in the same folder and enter your hotspot SSID/password.
 * "secrets.h" is ignored by .gitignore so credentials are never committed.
 */

#ifndef ESP32_CAM_SECRETS_H
#define ESP32_CAM_SECRETS_H

#define WIFI_SSID     "YOUR_HOTSPOT_SSID"
#define WIFI_PASSWORD "YOUR_HOTSPOT_PASSWORD"

#endif // ESP32_CAM_SECRETS_H
