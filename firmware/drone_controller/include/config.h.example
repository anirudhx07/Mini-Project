/**
 * @file config.h.example
 * @brief SkyForge Drone Controller Configuration Template
 * 
 * Instructions:
 * Copy this file to 'config.h' and supply your local network parameters.
 * 'config.h' is ignored by Git to avoid leaking credentials.
 */

#ifndef SKYFORGE_CONFIG_H
#define SKYFORGE_CONFIG_H

// ================= Wireless Network Configuration =================
#define WIFI_SSID           "REPLACE_WITH_YOUR_SSID"
#define WIFI_PASSWORD       "REPLACE_WITH_YOUR_PASSWORD"
#define GROUND_STATION_IP   "192.168.1.100"
#define GROUND_STATION_PORT 8080

// ================= Hardware Pin Mapping =================
// I2C Interface (MPU6050 6-DoF IMU)
#define PIN_I2C_SDA         21
#define PIN_I2C_SCL         22

// Motor PWM Outputs (N-Channel MOSFET Gates)
#define PIN_MOTOR_FL_CW     25  // Motor 1: Front-Left (Clockwise)
#define PIN_MOTOR_FR_CCW    26  // Motor 2: Front-Right (Counter-Clockwise)
#define PIN_MOTOR_RR_CW     27  // Motor 3: Rear-Right (Clockwise)
#define PIN_MOTOR_RL_CCW    14  // Motor 4: Rear-Left (Counter-Clockwise)

// Diagnostic & Battery Telemetry
#define PIN_STATUS_LED      33
#define PIN_BATTERY_ADC     32

// ================= Flight Control Safety Limits =================
#define PWM_FREQUENCY       20000   // 20 kHz ultrasonic PWM to silence audible motor whine
#define PWM_RESOLUTION      10      // 10-bit resolution (0 - 1023)
#define MAX_THROTTLE_LIMIT  800     // Capped duty cycle for bench & initial hover safety
#define MAX_TILT_ANGLE_DEG  45.0f   // Safety cut-off angle

#endif // SKYFORGE_CONFIG_H
